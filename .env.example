# long random string, e.g. `openssl rand -hex 32`
AUTH_SECRET=
ALLOW_SIGNUP=true
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:8080
OPENAI_API_KEY=
DATABASE_URL=postgresql+psycopg://translator:translator@db:5432/translator
FILES_DIR=/data
PROVIDER=fake
APP_ENV=dev
MAX_UPLOAD_MB=40
MAX_JOB_COST_CENTS=2000
PROVIDER_MAX_CONCURRENCY=32
PROVIDER_TPM_BUDGET=2000000
JOB_MAX_CONCURRENCY=16
SEGMENT_ATTEMPT_LIMIT=3
STALE_SECONDS=120
DEFAULT_MODEL=gpt-4o-mini
REVIEW_MODEL=gpt-4o
OCR_MODEL=gpt-4o
CLASSIFY_MODEL=gpt-4o-mini
MODELS_CONFIG=
FAKE_LATENCY_MS=0
FAKE_FAIL_MODE=
FAKE_FAIL_SEGMENTS=
FAKE_FAIL_RATE=1
CRASH_AFTER_SEGMENT=0
OTEL_EXPORTER=none
OTEL_ENDPOINT=http://langfuse:3000/api/public/otel/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# host URL for the Langfuse UI and CLI; compose overrides this to http://langfuse:3000 for the api and worker
LANGFUSE_BASE_URL=http://localhost:3001
AGENT_TRACE_EXPORTER=openai
CORS_ORIGINS=*
VITE_API_URL=
TRANSLATOR_API_TOKEN=
MCP_PORT=8001
REDIS_URL=redis://redis:6379/0
REALTIME_URL=http://realtime:8002
